# Local docker compose default. Overridden in CI by the NEON_DATABASE_URL secret.
DATABASE_URL=postgresql://ctp:ctp@localhost:5432/ctp

# Ingest window. Leave START blank for daily incremental (watermark decides).
CTP_LOOKBACK_DAYS=2

# API politeness. The public limit is roughly 50 req/min per IP.
CTP_REQUESTS_PER_MINUTE=40
CTP_PAGE_SIZE=1000
CTP_MAX_RETRIES=5
